{
  "name": "BadgeDay",
  "install": "./.cursor/install.sh",
  "terminals": [
    {
      "name": "api",
      "command": ".venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload"
    },
    {
      "name": "web",
      "command": "npm --prefix web run dev -- --host 0.0.0.0 --port 5173"
    }
  ],
  "ports": [
    { "name": "api", "port": 8000 },
    { "name": "web", "port": 5173 }
  ]
}
