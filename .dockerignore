# Keep the build context small and free of anything the image builds for itself or must
# never contain.

# Secrets — never in an image layer. Config comes from Container Apps env/secrets at runtime.
.env
.env.*
web/.env
web/.env.*

# Rebuilt inside the image (node stage / editable install).
web/node_modules
web/dist
.venv
*.egg-info

# Not needed at runtime.
.git
.github
tests
supabase
scripts
deploy
*.md
!recruit_rubric_c1_answer_construction.md
!recruit_rubric_c2_motivation.md
!recruit_rubric_c3_teamwork.md
!recruit_rubric_c4_integrity_ethics.md
!recruit_rubric_c5_judgment_composure.md
.pytest_cache
.ruff_cache
__pycache__
*.pyc

# No user or test documents in an image, ever.
*.pdf
*.docx
uploads
