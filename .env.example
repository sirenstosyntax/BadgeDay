# Copy to .env and fill in. Never commit .env.

# --- Runtime -----------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Anthropic ---------------------------------------------------------------
ANTHROPIC_API_KEY=
GENERATION_MODEL=claude-sonnet-5
# Reasoning depth for generation: low | medium | high | xhigh | max
GENERATION_EFFORT=high

# --- Azure Document Intelligence ---------------------------------------------
# Resource: sts-docintel (resource group sts-examgen-rg)
# Leave blank to use the fixture analyzer in tests and local development.
AZURE_DOCINTEL_ENDPOINT=
AZURE_DOCINTEL_KEY=

# --- Supabase ----------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string, used only to apply migrations and verify RLS.
# Supabase dashboard -> Project Settings -> Database -> Connection string (URI).
# Substitute your database password for [YOUR-PASSWORD] in the copied string.
SUPABASE_DB_URL=

# --- Stripe ------------------------------------------------------------------
# Pricing is configurable, never hardcoded. Create the products in Stripe and
# reference their price IDs here.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_INTENSIVE_90DAY=
