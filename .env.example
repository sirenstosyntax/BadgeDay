# Copy to .env and fill in. Never commit .env.

# --- Runtime -----------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Anthropic ---------------------------------------------------------------
ANTHROPIC_API_KEY=
GENERATION_MODEL=claude-sonnet-5
# Reasoning depth for generation: low | medium | high | xhigh | max
GENERATION_EFFORT=high

# --- Azure Document Intelligence ---------------------------------------------
# Resource: sts-docintel (resource group sts-examgen-rg)
# Leave blank to use the fixture analyzer in tests and local development.
AZURE_DOCINTEL_ENDPOINT=
AZURE_DOCINTEL_KEY=

# --- Supabase ----------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string, used only to apply migrations and verify RLS.
# Supabase dashboard -> Project Settings -> Database -> Connection string (URI).
# Substitute your database password for [YOUR-PASSWORD] in the copied string.
SUPABASE_DB_URL=

# --- Uploads -----------------------------------------------------------------
# Largest single document a candidate may upload, in bytes. Defaults to 25 MB.
MAX_UPLOAD_BYTES=

# --- Stripe ------------------------------------------------------------------
# Pricing is configurable, never hardcoded. Create the products in Stripe and
# reference their price IDs here. STRIPE_WEBHOOK_SECRET is the signing secret for the
# /billing/webhook endpoint (Stripe dashboard -> Developers -> Webhooks -> your endpoint,
# or `stripe listen` when developing locally).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_INTENSIVE_90DAY=
# How long the one-time intensive pass grants access. The Stripe price is a fixed charge;
# this is the entitlement it buys.
INTENSIVE_PASS_DAYS=90

# Where the browser app lives — used to build the URLs Stripe returns the candidate to
# after checkout or the billing portal. Not the API's own origin.
# This is the local value. The hosted app does not read it from here: deploy/azure-deploy.sh
# sets PUBLIC_WEB_URL to https://app.badgeday.com (the app's canonical host — NOT badgeday.com,
# which is the separate marketing/waitlist site) once that hostname is bound, and to the
# ingress FQDN until it is. So this file can stay a laptop's value, like ENVIRONMENT does.
PUBLIC_WEB_URL=http://localhost:5173

# --- App stores --------------------------------------------------------------
# The second and third tills. Both stores require that a subscription sold inside their app
# is bought through their own billing system, so the phone apps do not use Stripe. Leave
# every value blank until the store accounts exist: blank means the store endpoints answer
# 503, which is the correct behaviour for a payment path that cannot yet tell a real
# purchase from an invented one. See mobile_release_plan.md.

# Google Play. The service account JSON is the whole key file's contents, on one line.
PLAY_PACKAGE_NAME=
PLAY_PRODUCT_ID_MONTHLY=
PLAY_PRODUCT_ID_INTENSIVE_90DAY=
PLAY_SERVICE_ACCOUNT_JSON=
# The Pub/Sub push subscription's OIDC audience, and the service account it pushes as. Both
# are checked on every notification; without them, any POST to the notification URL would be
# believed.
PLAY_PUBSUB_AUDIENCE=
PLAY_PUBSUB_SERVICE_ACCOUNT=

# Apple. The private key is the .p8 file's contents, newlines and all.
APPSTORE_BUNDLE_ID=
APPSTORE_PRODUCT_ID_MONTHLY=
APPSTORE_PRODUCT_ID_INTENSIVE_90DAY=
APPSTORE_ISSUER_ID=
APPSTORE_KEY_ID=
APPSTORE_PRIVATE_KEY=
# Apple's root certificates, comma-separated base64 DER, from
# https://www.apple.com/certificateauthority/ (Apple Root CA G3 is the one that signs App
# Store Server Notifications). Required — the verifier has no built-in trust store, and
# without these it rejects every genuine notification while looking configured.
APPSTORE_ROOT_CERTS=
# sandbox | production. Apple's sandbox signs with a different chain, so a mismatch rejects
# every notification with a signature error that reads like a credential problem.
APPSTORE_ENVIRONMENT=sandbox

# Canonical host and its alternates. When CANONICAL_HOST is set, any request arriving on a
# host listed in REDIRECT_HOSTS is 301'd to it (https). Leave both empty in development.
#
# The app answers on a single host — app.badgeday.com — so in production these normally
# stay empty as well. They exist only if the app ever needs to force some other host it
# answers on onto the canonical one. The badgeday.com / badgeday.app consolidation is NOT
# done here: badgeday.com is the marketing/waitlist site (Netlify, permanent apex), and
# badgeday.app 301s to it at the DNS/hosting layer — neither ever routes through this app.
CANONICAL_HOST=
REDIRECT_HOSTS=
