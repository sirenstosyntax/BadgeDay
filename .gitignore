# Secrets
.env
.env.local

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# User-uploaded documents — never in git history
uploads/
*.pdf
*.docx
!tests/fixtures/*

# Frontend
node_modules/
dist/

# Mobile wrappers — generated native projects, and signing material.
# The Android keystore is the one file here that must never be committed and must never be
# lost: it is the identity of the app, and Play will not accept an upload signed with a
# different key. It belongs in a password manager, not in git and not only on a laptop.
mobile/android/app/
mobile/android/gradle/
mobile/android/gradlew
mobile/android/gradlew.bat
mobile/android/build.gradle
mobile/android/settings.gradle
mobile/android/gradle.properties
mobile/android/local.properties
mobile/android/store_icon.png
mobile/android/manifest-checksum.txt
mobile/android/*.apk
mobile/android/*.aab
mobile/android/*.keystore
mobile/android/*.jks
mobile/android/*.keystore.json
mobile/ios/ios/
mobile/ios/App/

# Fastlane / signing leftovers from a local or CI iOS run. Never commit
# key material; the .p8 / .p12 belong in GitHub secrets, not here.
mobile/ios/vendor/
mobile/ios/.bundle/
mobile/ios/fastlane/report.xml
mobile/ios/fastlane/Preview.html
mobile/ios/*.ipa
mobile/ios/*.dSYM.zip
mobile/ios/AuthKey_*.p8
mobile/ios/*.p12
mobile/ios/*.mobileprovision

# Local TWA / iOS compile output. Not a store submit by itself.
artifacts/twa/
artifacts/ios/

# Editor / OS
.DS_Store
.idea/
.vscode/
