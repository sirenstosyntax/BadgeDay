# Copy to .env.local and fill in. Never commit .env.local.
#
# Everything here reaches the browser — Vite inlines VITE_ variables at build time. That
# is correct for all three: the URL and publishable key identify the project without
# granting anything, and access is decided by the candidate's own token plus RLS. The
# service role key must never appear in this file.

VITE_SUPABASE_URL=
# Supabase dashboard -> Connect -> App Frameworks. Starts with sb_publishable_.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Where the BadgeDay API is served. Defaults to http://localhost:8000 when unset.
VITE_API_URL=http://localhost:8000
